    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float weights[8];\r\n\r\nweights[0] = Weights0.x;\r\nweights[1] = Weights0.y;\r\nweights[2] = Weights0.z;\r\nweights[3] = Weights0.w;\r\nweights[4] = Weights1.x;\r\nweights[5] = Weights1.y;\r\nweights[6] = Weights1.z;\r\nweights[7] = Weights1.w;\r\n\r\nint bestIndex = 0;\r\nint secondIndex = 1;\r\n\r\nfloat bestWeight = weights[0];\r\nfloat secondWeight = weights[1];\r\n\r\nif (secondWeight > bestWeight)\r\n{\r\n    int tempIndex = bestIndex;\r\n    bestIndex = secondIndex;\r\n    secondIndex = tempIndex;\r\n\r\n    float tempWeight = bestWeight;\r\n    bestWeight = secondWeight;\r\n    secondWeight = tempWeight;\r\n}\r\n\r\n[unroll]\r\nfor (int i = 2; i < 8; i++)\r\n{\r\n    float candidate = weights[i];\r\n\r\n    if (candidate > bestWeight)\r\n    {\r\n        secondWeight = bestWeight;\r\n        secondIndex = bestIndex;\r\n\r\n        bestWeight = candidate;\r\n        bestIndex = i;\r\n    }\r\n    else if (candidate > secondWeight)\r\n    {\r\n        secondWeight = candidate;\r\n        secondIndex = i;\r\n    }\r\n}\r\n\r\nIndexA = (float)bestIndex;\r\nIndexB = (float)secondIndex;\r\n\r\nWeightA = bestWeight;\r\nWeightB = secondWeight;\r\n\r\nfloat selectedTotal = max(bestWeight + secondWeight, 0.00001);\r\n\r\nNormalizedA = bestWeight / selectedTotal;\r\nNormalizedB = secondWeight / selectedTotal;"
}

