{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "ab49c3278f00418f8c1642bd3c61b965",
    "m_Title": "! NOTE: VERTEX PAINTING !",
    "m_Content": "RED CHANNEL = MUD BUILD UP\nBLACK = NO EFFECT (Required on tire base mesh\nRED = EXTRUDE (For Mud_Buildup mesh ONLY)\n\ntldr: UV edge perimeter verts black, rest red on buildupmesh\n        all verts black, on main tire mesh\n\n",
    "m_TextSize": 1,
    "m_Theme": 1,
    "m_Position": {
        "serializedVersion": "2",
        "x": 4825.0,
        "y": -1005.0,
        "width": 754.0,
        "height": 226.0
    },
