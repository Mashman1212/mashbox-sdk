#pragma kernel GenerateDetailInstances
#pragma target 5.0

struct SpawnCommand
{
    uint x;
    uint z;
    uint count;
    uint outputStart;
    uint layerIndex;
    uint padding0;
    uint padding1;
    uint padding2;
    float4 sizes;
};

struct LayerParameters
{
    uint width;
    uint height;
    uint seed;
    uint padding0;
    float minWidth;
    float maxWidth;
    float minHeight;
    float maxHeight;
    float yOffset;
    float padding1;
    float padding2;
    float padding3;
};

StructuredBuffer<SpawnCommand> _Commands;
StructuredBuffer<LayerParameters> _Layers;
StructuredBuffer<float> _SurfaceHeights;
RWByteAddressBuffer _InstanceData;

uint _CommandOffset;
uint _GroupOutputBase;
uint _ObjectToWorldAddress;
uint _WorldToObjectAddress;
uint _DetailDataAddress;
uint _SurfaceGridWidth;
uint _SurfaceGridHeight;
float4 _SurfaceMinMax;
float4x4 _TerrainLocalToWorld;
float4x4 _PartRelative;

uint Hash(uint value)
{
    value ^= value >> 16;
    value *= 0x7FEB352D;
    value ^= value >> 15;
    value *= 0x846CA68B;
    value ^= value >> 16;
    return value;
}

float Hash01(uint value)
{
    return (value & 0x00FFFFFF) * (1.0 / 16777216.0);
}

float SampleSurfaceHeight(float2 normalizedPosition)
{
    float2 grid = saturate(normalizedPosition) * float2(_SurfaceGridWidth - 1, _SurfaceGridHeight - 1);
    uint x0 = min((uint)floor(grid.x), _SurfaceGridWidth - 2);
    uint z0 = min((uint)floor(grid.y), _SurfaceGridHeight - 2);
    float2 blend = grid - float2(x0, z0);
    uint bottomIndex = z0 * _SurfaceGridWidth + x0;
    uint topIndex = (z0 + 1) * _SurfaceGridWidth + x0;
    float bottom = lerp(_SurfaceHeights[bottomIndex], _SurfaceHeights[bottomIndex + 1], blend.x);
    float top = lerp(_SurfaceHeights[topIndex], _SurfaceHeights[topIndex + 1], blend.x);
    return lerp(bottom, top, blend.y);
}

void StorePackedMatrix(uint baseAddress, uint instanceIndex, float4x4 value)
{
    uint address = baseAddress + instanceIndex * 48;
    uint3 column0 = uint3(asuint(value[0][0]), asuint(value[1][0]), asuint(value[2][0]));
    uint3 column1 = uint3(asuint(value[0][1]), asuint(value[1][1]), asuint(value[2][1]));
    uint3 column2 = uint3(asuint(value[0][2]), asuint(value[1][2]), asuint(value[2][2]));
    uint3 column3 = uint3(asuint(value[0][3]), asuint(value[1][3]), asuint(value[2][3]));
    _InstanceData.Store3(address + 0, column0);
    _InstanceData.Store3(address + 12, column1);
    _InstanceData.Store3(address + 24, column2);
    _InstanceData.Store3(address + 36, column3);
}

float4x4 InverseAffine(float4x4 value)
{
    float3 column0 = float3(value[0][0], value[1][0], value[2][0]);
    float3 column1 = float3(value[0][1], value[1][1], value[2][1]);
    float3 column2 = float3(value[0][2], value[1][2], value[2][2]);
    float determinant = dot(column0, cross(column1, column2));
    float inverseDeterminant = rcp(determinant);
    float3 row0 = cross(column1, column2) * inverseDeterminant;
    float3 row1 = cross(column2, column0) * inverseDeterminant;
    float3 row2 = cross(column0, column1) * inverseDeterminant;
    float3 translation = float3(value[0][3], value[1][3], value[2][3]);
    float3 inverseTranslation = -float3(
        dot(row0, translation),
        dot(row1, translation),
        dot(row2, translation));
    return float4x4(
        row0.x, row0.y, row0.z, inverseTranslation.x,
        row1.x, row1.y, row1.z, inverseTranslation.y,
        row2.x, row2.y, row2.z, inverseTranslation.z,
        0, 0, 0, 1);
}

[numthreads(64, 1, 1)]
void GenerateDetailInstances(uint3 groupId : SV_GroupID, uint3 groupThreadId : SV_GroupThreadID)
{
    SpawnCommand command = _Commands[_CommandOffset + groupId.x];
    LayerParameters layer = _Layers[command.layerIndex];
    uint cellHash = Hash(layer.seed ^ (command.x * 73856093) ^ (command.z * 19349663));

    for (uint item = groupThreadId.x; item < command.count; item += 64)
    {
        uint hash = Hash(cellHash ^ (item * 83492791));
        float jitterX = Hash01(hash);
        float jitterZ = Hash01(Hash(hash + 0x9E3779B9));
        float widthScale = lerp(layer.minWidth, layer.maxWidth, Hash01(Hash(hash + 0x85EBCA6B)));
        float heightScale = lerp(layer.minHeight, layer.maxHeight, Hash01(Hash(hash + 0xC2B2AE35)));
        float paintedSize = lerp(lerp(command.sizes.x, command.sizes.y, jitterX), lerp(command.sizes.z, command.sizes.w, jitterX), jitterZ);
        widthScale *= paintedSize;
        heightScale *= paintedSize;
        float angle = Hash01(Hash(hash + 0x27D4EB2F)) * 6.28318530718;
        float2 normalizedPosition = float2(
            (command.x + jitterX) / max(1.0, (float)layer.width),
            (command.z + jitterZ) / max(1.0, (float)layer.height));
        float localX = lerp(_SurfaceMinMax.x, _SurfaceMinMax.z, normalizedPosition.x);
        float localZ = lerp(_SurfaceMinMax.y, _SurfaceMinMax.w, normalizedPosition.y);
        float localY = SampleSurfaceHeight(normalizedPosition) + layer.yOffset;
        float sine;
        float cosine;
        sincos(angle, sine, cosine);
        float4x4 localMatrix = float4x4(
            cosine * widthScale, 0, sine * widthScale, localX,
            0, heightScale, 0, localY,
            -sine * widthScale, 0, cosine * widthScale, localZ,
            0, 0, 0, 1);
        float4x4 objectToWorld = mul(_TerrainLocalToWorld, mul(localMatrix, _PartRelative));
        float4x4 worldToObject = InverseAffine(objectToWorld);
        uint destination = _GroupOutputBase + command.outputStart + item;
        _InstanceData.Store4(_DetailDataAddress + destination * 16,
            asuint(float4(command.layerIndex, Hash01(Hash(hash + 0x165667B1)), (item + 1.0) / max(1u, command.padding0), layer.padding1)));
        StorePackedMatrix(_ObjectToWorldAddress, destination, objectToWorld);
        StorePackedMatrix(_WorldToObjectAddress, destination, worldToObject);
    }
}

// Expand compact per-texel visibility ranges, preserving the direct renderer's
// exact selection. GPU-written counts feed BRG indirect draw commands.
#pragma kernel BuildVisibleIndices
StructuredBuffer<uint4> _VisibilityRanges;
RWByteAddressBuffer _VisibleIndices;
RWStructuredBuffer<uint> _IndirectArgs;
uint _VisibilityRangeOffset;

[numthreads(64, 1, 1)]
void BuildVisibleIndices(uint3 group : SV_GroupID, uint thread : SV_GroupIndex)
{
    uint4 range = _VisibilityRanges[_VisibilityRangeOffset + group.x];
    for (uint i = thread; i < range.y; i += 64)
        _VisibleIndices.Store((range.z + i) * 4, range.x + i);
    if (thread == 0)
        InterlockedAdd(_IndirectArgs[range.w * 5 + 1], range.y);
}

#pragma kernel ResetCulledArgs
#pragma kernel CullTerrainDetails
struct OcclusionDraw { float3 center; uint offset; float3 extents; float padding; };
StructuredBuffer<OcclusionDraw> _OcclusionDraws;
StructuredBuffer<uint> _SourceArgs;
RWStructuredBuffer<uint> _CulledArgs;
RWByteAddressBuffer _CulledIndices;
Texture2D<float> _TerrainHeightMin;
uint _OcclusionDrawCount;
uint _CullDetailFrustum, _CullTerrainOcclusion;
uint _CullRenderedDepth;
Texture2D<float> _RenderedDepthPyramid;
float4x4 _RenderedDepthLocalToClip;
float4 _RenderedDepthSize, _RenderedDepthConvention;
float4x4 _OcclusionWorldToLocal;
float3 _OcclusionCameraLocal, _OcclusionPadding;
float4 _OcclusionSurface, _OcclusionGrid;
float4 _OcclusionPlanes[6];

[numthreads(64, 1, 1)]
void ResetCulledArgs(uint id : SV_DispatchThreadID)
{
    if (id >= _OcclusionDrawCount) return;
    for (uint i = 0; i < 5; i++) _CulledArgs[id * 5 + i] = i == 1 ? 0 : _SourceArgs[id * 5 + i];
}

bool TerrainHidesBounds(float3 center, float3 extent)
{
    // At each section of the camera-to-AABB cone, ALL rays lie below this
    // upper Y and inside this XZ rectangle. Cull only if the minimum terrain
    // over the ENTIRE rectangle lies above it. Sparse point-ray hits would
    // not establish this and could hide a visible treetop or gap.
    for (uint step = 1; step <= 8; step++)
    {
        float t = step / 9.0;
        float3 c = lerp(_OcclusionCameraLocal, center, t);
        float3 e = extent * t;
        float2 lo = (c.xz - e.xz - _OcclusionSurface.xy) * _OcclusionSurface.zw;
        float2 hi = (c.xz + e.xz - _OcclusionSurface.xy) * _OcclusionSurface.zw;
        if (any(lo < 0) || any(hi >= _OcclusionGrid.xy)) continue;
        float2 first = floor(lo), last = floor(hi);
        uint mip = (uint)clamp(floor(log2(max(1.0, max(last.x - first.x + 1, last.y - first.y + 1)))) - 1, 0, _OcclusionGrid.z);
        uint2 a = (uint2)first >> mip, b = (uint2)last >> mip;
        // At most 3x3 blocks; taking their minimum covers every point in the cone.
        float h = 1e20;
        for (uint z = a.y; z <= b.y; z++)
            for (uint x = a.x; x <= b.x; x++) h = min(h, _TerrainHeightMin.Load(int3(x, z, mip)));
        if (c.y + e.y + 0.05 < h) return true;
    }
    return false;
}

bool SceneDepthHidesBounds(float3 center, float3 extent)
{
    float2 lo = 1, hi = 0;
    float nearest = 1;
    for (uint corner = 0; corner < 8; corner++)
    {
        float3 sign = float3((corner & 1) ? 1 : -1, (corner & 2) ? 1 : -1, (corner & 4) ? 1 : -1);
        float4 clip = mul(_RenderedDepthLocalToClip, float4(center + extent * sign, 1));
        // Camera/near-plane crossings cannot be safely tested with this projection.
        if (clip.w <= 0.0001) return false;
        float3 ndc = clip.xyz / clip.w;
        float depth = ndc.z * _RenderedDepthConvention.z + _RenderedDepthConvention.w;
        if (depth <= 0 || depth >= 1) return false;
        depth = _RenderedDepthSize.w != 0 ? 1 - depth : depth;
        nearest = min(nearest, depth);
        float2 uv = ndc.xy * _RenderedDepthConvention.xy + 0.5;
        lo = min(lo, uv); hi = max(hi, uv);
    }
    // Include a rasterization margin and fail open at screen edges.
    lo = floor(lo * _RenderedDepthSize.xy) - 2;
    hi = ceil(hi * _RenderedDepthSize.xy) + 2;
    if (any(lo < 0) || any(hi >= _RenderedDepthSize.xy)) return false;
    float span = max(hi.x - lo.x + 1, hi.y - lo.y + 1);
    uint mip = (uint)clamp(floor(log2(max(1.0, span))) - 1, 0, _RenderedDepthSize.z);
    uint2 a = (uint2)lo >> mip, b = (uint2)hi >> mip;
    float farthest = 0;
    for (uint y = a.y; y <= b.y; y++)
        for (uint x = a.x; x <= b.x; x++) farthest = max(farthest, _RenderedDepthPyramid.Load(int3(x, y, mip)));
    return nearest > farthest + 0.0001;
}

bool KeepDetail(uint instance, OcclusionDraw draw)
{
    uint address = _ObjectToWorldAddress + instance * 48;
    float3 x = asfloat(_InstanceData.Load3(address));
    float3 y = asfloat(_InstanceData.Load3(address + 12));
    float3 z = asfloat(_InstanceData.Load3(address + 24));
    float3 p = asfloat(_InstanceData.Load3(address + 36));
    float3 center = mul(_OcclusionWorldToLocal, float4(p + x * draw.center.x + y * draw.center.y + z * draw.center.z, 1)).xyz;
    x = mul((float3x3)_OcclusionWorldToLocal, x);
    y = mul((float3x3)_OcclusionWorldToLocal, y);
    z = mul((float3x3)_OcclusionWorldToLocal, z);
    float3 extent = abs(x) * draw.extents.x + abs(y) * draw.extents.y + abs(z) * draw.extents.z + _OcclusionPadding;
    if (_CullDetailFrustum != 0)
        for (uint i = 0; i < 6; i++)
            if (dot(_OcclusionPlanes[i].xyz, center) + _OcclusionPlanes[i].w
                + dot(abs(_OcclusionPlanes[i].xyz), extent) < 0) return false;
    if (_CullTerrainOcclusion != 0 && TerrainHidesBounds(center, extent)) return false;
    return _CullRenderedDepth == 0 || !SceneDepthHidesBounds(center, extent);
}

groupshared uint keptCount, outputStart;
groupshared uint keptInstances[1024];
[numthreads(64, 1, 1)]
void CullTerrainDetails(uint3 group : SV_GroupID, uint thread : SV_GroupIndex)
{
    uint4 range = _VisibilityRanges[_VisibilityRangeOffset + group.x];
    OcclusionDraw draw = _OcclusionDraws[range.w];
    if (thread == 0) keptCount = 0;
    GroupMemoryBarrierWithGroupSync();
    for (uint i = thread; i < range.y; i += 64)
    {
        uint instance = range.x + i;
        if (KeepDetail(instance, draw))
        {
            uint slot;
            InterlockedAdd(keptCount, 1, slot);
            keptInstances[slot] = instance;
        }
    }
    GroupMemoryBarrierWithGroupSync();
    if (thread == 0) InterlockedAdd(_CulledArgs[range.w * 5 + 1], keptCount, outputStart);
    GroupMemoryBarrierWithGroupSync();
    for (uint j = thread; j < keptCount; j += 64)
        _CulledIndices.Store((draw.offset + outputStart + j) * 4, keptInstances[j]);
}
